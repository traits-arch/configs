{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "source": "/home/xal/.config/fastfetch/sticker.png",
    "width": 43,
    "height": 21,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 4
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    // --- Hardware Section ---
    {
      "type": "custom",
      "format": "┌──────────────── Hardware ────────────────┐"
    },
    {
      "type": "cpu",
      "key": " ├─  ",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": " ├─ 󰍛 ",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": " ├─ 󰘚 ",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": " └─ 󰋊 ",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    "break",

    // --- Software Section ---
    {
      "type": "custom",
      "format": "┌──────────────── Software ─────────────────┐"
    },
    {
      "type": "os",
      "key": " ├─ 󰌽 ",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": " ├─  ",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": " ├─ 󰏖 ",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": " ├─ 󰞷 ",
      "keyColor": "red"
    },
    {
      "type": "font",
      "key": " ├─ 󰛖 ",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": " └─ 󰞷 ",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "└───────────────────────────────────────────┘"
    },
    "break",

    // --- Desktop / WM Section ---
    {
      "type": "custom",
      "format": "┌─────────── Desktop Environment ───────────┐"
    },
    {
      "type": "wm",
      "key": " ├─ 󰨇 ",
      "keyColor": "red"
    },
    {
      "type": "theme",
      "key": " ├─ 󰉼 ",
      "keyColor": "red"
    },
    {
      "type": "icons",
      "key": " └─ 󰀻 ",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "└───────────────────────────────────────────┘"
    },
    "break",

    // --- Uptime / Age Section ---
    {
      "type": "custom",
      "format": "┌────────────── Uptime / Age ───────────────┐"
    },
    {
      "type": "command",
      "key": " ├─ 󰅐 OS Age ",
      "keyColor": "red",
      "text": "sh -c 'birth=$(stat -c %W /); current=$(date +%s); echo \"$(( (current - birth) / 86400 )) days\"'"
    },
    {
      "type": "uptime",
      "key": " └─ 󰔛 Uptime ",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "└───────────────────────────────────────────┘"
    }
  ]
}
