// =====================================================================
// NIRI CONFIGURATION - macOS & Modern Minimalist Aesthetic
// =====================================================================

// ---------------------------------------------------------------------
// ENVIRONMENT VARIABLES
// ---------------------------------------------------------------------
environment {
    DISPLAY ":0"
    MOZ_ENABLE_WAYLAND "1"
    XDG_CURRENT_DESKTOP "Niri"
    XDG_SESSION_TYPE "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    GTK_THEME "HighContrastInverse"
}
// ---------------------------------------------------------------------
// INPUT CONFIGURATION
// ---------------------------------------------------------------------
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.5
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// ---------------------------------------------------------------------
// LAYOUT & MAC-LIKE GEOMETRY
// ---------------------------------------------------------------------
//prefer-no-csd

layout {
    // Spacing & Padding
    gaps 8
     
    //transparent background for workspace
    background-color "#00000000"
    // Rounded Corners & Clipping
    // Focus Ring (black)
    focus-ring {
        width 4
        active-color "#333232"
        inactive-color "#FFFFFF"
        
    }
    //tab-indicator {
    //     off
    //}

    // Secondary Outer Border
    border {
        off
        width 4
        active-color "#7cf8ff"
        inactive-color "#505050"
    }

    // Shadow setup for depth
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    // Column Width Presets
    default-column-width { proportion 0.5; }
    
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}
layer-rule {
    match namespace="^swaybg$"
    place-within-backdrop true
}
layer-rule {
    match namespace="swaync-control-center"
    //match namespace="swaync-notification-window"
    geometry-corner-radius 26
    background-effect {
        blur true
        xray true
    }
}
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}
layer-rule {
    match namespace="rofi"
    geometry-corner-radius 22
    background-effect {
        blur true
        xray true
    }
}
//-----Cursor ----
cursor {
      xcursor-theme "Future-dark-cursors"
      xcursor-size 30
}
// ---------------------------------------------------------------------
// ANIMATIONS
// ---------------------------------------------------------------------
animations {
    // Enable smooth physics-based movement
    slowdown 3.0

     window-open {
           spring stiffness=1000 damping-ratio=0.7 epsilon=0.0001
     }
     window-close {
           spring stiffness=1000 damping-ratio=0.7 epsilon=0.0001
     }
}
// ---------------------------------------------------------------------
// WINDOW RULES (Aesthetics & Behavior)
// ---------------------------------------------------------------------
// Add subtle translucency to unfocused windows
window-rule {
    geometry-corner-radius 22
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.90
    background-effect {
        blur true
        xray true
    }
}
window-rule {
    match app-id="scratchpad"
    open-floating true
    default-floating-position x=20 y=30 relative-to="top-left"
    // Sets the window size (e.g. 50% width, 40% height)
    default-column-width { proportion 0.4; }
    default-window-height { proportion 0.4; }
    focus-ring { off; }
}
window-rule {
    match app-id="^Alacritty$"
    draw-border-with-background false
    min-width 0
    opacity 1.0
    geometry-corner-radius 22
    clip-to-geometry true
    focus-ring { off; }
    border { off; }
}
window-rule {
    match app-id="rofi"
    opacity 0.90
    geometry-corner-radius 22	
    open-floating true
}

recent-windows {   
       highlight {
	   active-color "#ffffff20"
	   urgent-color "#ff555580"
	   corner-radius 18
       }
}
hotkey-overlay {
    skip-at-startup
}

//Spawn at startup
//spawn-at-startup "sh" "-c" "sleep 2 && hypridle"
spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"
spawn-at-startup "swaybg" "-m" "fill" "-i" "/home/xal/Downloads/wallhaven-0we3m7_1920x1200.png"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "waybar"
// ---------------------------------------------------------------------
// KEYBINDINGS
// ---------------------------------------------------------------------
binds {
    // --- Application Launchers ---
    Mod+Return { spawn "alacritty"; }
    Mod+D      { spawn "/home/xal/.config/rofi/launchers/type-7/launcher.sh"; }
    Mod+E      { spawn "/home/xal/.config/rofi/powermenu/type-4/powermenu.sh"; }
    // --- Window Actions ---
    Mod+Q       { close-window; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V       { toggle-window-floating; }
    Mod+L       { spawn "hyprlock";}
    
    // Take an interactive screenshot of a selected area
    Mod+S { screenshot; }

    // Take a screenshot of the currently focused window
    Mod+Ctrl+W { screenshot-window; }

    // Take a screenshot of the active screen/monitor
    Mod+Ctrl+S { screenshot-screen; }
    //Open clipboard
    Mod+Period  { spawn "sh" "-c" "cliphist list | rofi -dmenu -theme ~/.config/rofi/cliphist/cliphist.rasi | cliphist decode | wl-copy"; }
    // Toggle Waybar visibility with Super + W
    Mod+W { spawn "pkill" "-USR1" "waybar"; }
    
    Mod+Grave { spawn "alacritty" "--class" "scratchpad" "-e" "env" "SKIP_FETCH=1" "zsh" ; }
    Mod+ALt+Space { spawn "sh" "-c" "niri msg action move-column-to-last && sleep 1 && niri msg action focus-window-previous"; } 
    // --- Navigation (Focus) ---
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+I    { set-window-height "-10%"; }
    Mod+K  { set-window-height "+10%"; }
    Mod+R  { focus-window-previous; }

    // --- Moving Windows ---
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+J  { consume-or-expel-window-left; }
    Mod+Shift+L  { consume-or-expel-window-right; }
    Mod+T        { toggle-column-tabbed-display; }
    // --- Workspace Focus ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    // --- Move Windows to Workspaces ---
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // --- Session Control ---
    Mod+Shift+E { quit; }
    //inbuilt commands
    // Volume keys
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    // Brightness keys
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "+10%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
    //Extra-Motherboard-Keys
    //XF86SeleectiveScreenshort { screenshot-screen-region; }
    //XF86TouchpadToggle { spawn "wpctl" "toggle" "touchpad"; }
}
